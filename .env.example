# Copy this file to .env for local development, and add the same values in
# your host's environment settings (Vercel or Netlify) for the live site.

# The live address of the site, no trailing slash. Used for the canonical
# link, link previews and sitemap. e.g. https://gptpharm.ng
VITE_SITE_URL=

# Supabase project behind the "Notify me" form.
# The publishable key is meant to live in the browser. The signups table only
# accepts inserts, so nobody can read the list back out through the website.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
